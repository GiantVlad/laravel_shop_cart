<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <!-- <server>, not <env>: Laravel's env() reads $_SERVER before $_ENV, and the container exports
         these very variables (compose env_file / the server's .env). With <env> the suite quietly
         kept using the dev `shop` database, the dev cache/session drivers and the dev queue, which
         is why RefreshDatabase used to empty the working database.
         force="true" is needed as well: without it PHPUnit leaves an already-set variable alone. -->
    <server name="APP_ENV" value="testing" force="true"/>
    <server name="CACHE_DRIVER" value="array" force="true"/>
    <server name="SESSION_DRIVER" value="array" force="true"/>
    <server name="QUEUE_DRIVER" value="sync" force="true"/>
    <!-- DB_DATABASE is forced so a stray run can never target the dev `shop` database. DB_HOST is
         deliberately NOT forced: CI exports 127.0.0.1 for its service container, the dev container
         / .env.testing provide `mariadb`, and forcing it here would break one of the two. -->
    <server name="DB_DATABASE" value="shop_test" force="true"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
