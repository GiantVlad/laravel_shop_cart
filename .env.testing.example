APP_KEY= your app key from .env
APP_URL=http://localhost

# Mirrors phpunit.xml, which forces these values for the test run anyway. shop_test is a second
# database inside the dev MariaDB container (see .docker/mariadb/init/).
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=shop_test
DB_USERNAME=admin
DB_PASSWORD=secret

